APP_NAME=club-event-service
APP_PORT=8003
DATABASE_URL=sqlite:///./campushub_events.db

# Grup 5 - AI Inference Service
AI_SERVICE_URL=http://ai-service:8005
# AI bu sureden uzun yanit vermezse etkinlik kategori "OTHER" ile kaydedilir
AI_TIMEOUT_SECONDS=3
# false yapilirsa AI hic cagrilmaz (AI servisi hazir degilken lokal gelistirme icin)
AI_ENABLED=true

# Gateway / web arayuzu origin'leri, virgulle ayrilmis. Ornek: http://localhost:3000
CORS_ORIGINS=*
